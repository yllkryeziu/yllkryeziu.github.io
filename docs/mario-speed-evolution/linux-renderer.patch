+        fprintf(stderr, "frame readback failed: GL error 0x%x\n", (unsigned) error);
+        exit(1);
+    }
+    // Strip alpha in place, then write the same RGB PPM format as the desktop renderer.
+    for (size_t i = 0; i < (size_t) w * h; ++i) {
+        px[3*i] = px[4*i];
+        px[3*i+1] = px[4*i+1];
